    "test:sso": "bash test/sso.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "multer": "^2.5.0",
    "openid-client": "^6.8.7"
  },
  "keywords": [
    "image-host",
    "self-hosted",
    "image-upload",
    "fail2ban",
    "caddy",
