{
  "name": "contactsheet",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted image host with short public addresses, per-image privacy, and fail2ban protection",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "adduser": "node scripts/adduser.js",
    "passwd": "node scripts/passwd.js",
    "lsusers": "node scripts/lsusers.js",
    "set-email": "node scripts/setemail.js",
